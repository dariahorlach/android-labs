<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FAFAFA">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Смарт-керування екраном"
                android:textSize="22sp"
                android:textStyle="bold"
                android:layout_marginBottom="32dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Рівень освітлення:"
                android:textSize="18sp"
                android:textColor="#555555"/>

            <TextView
                android:id="@+id/tvLightLevel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0 lx"
                android:textSize="36sp"
                android:textStyle="bold"
                android:textColor="#FF9800"
                android:layout_marginBottom="24dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Стан датчика наближення:"
                android:textSize="18sp"
                android:textColor="#555555"/>

            <TextView
                android:id="@+id/tvProximity"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Далеко"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="#4CAF50"
                android:layout_marginBottom="32dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="* Яскравість цього вікна автоматично підлаштовується під освітлення. Перекрийте верхню частину телефону (камеру), щоб імітувати блокування в кишені."
                android:textAlignment="center"
                android:textSize="14sp" />

        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/lockOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:background="#000000"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ЕКРАН ЗАБЛОКОВАНО"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="(Датчик наближення активний)"
            android:textColor="#AAAAAA"
            android:textSize="16sp"
            android:layout_marginTop="8dp" />
    </LinearLayout>

</FrameLayout>