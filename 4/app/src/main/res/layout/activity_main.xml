<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#2F4F4F">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <androidx.media3.ui.PlayerView
            android:id="@+id/mediaPlayerView"
            android:layout_width="match_parent"
            android:layout_height="250dp"
            android:background="#1C1C1C"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Джерело відтворення:"
            android:textStyle="bold"
            android:textSize="18sp"
            android:layout_marginTop="24dp"
            app:layout_constraintTop_toBottomOf="@id/mediaPlayerView"
            app:layout_constraintStart_toStartOf="parent" />

        <EditText
            android:id="@+id/etNetworkUrl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Введіть посилання (URL)"
            android:inputType="textUri"
            android:layout_marginTop="12dp"
            app:layout_constraintTop_toBottomOf="@id/tvTitle"
            app:layout_constraintStart_toStartOf="parent" />

        <Button
            android:id="@+id/btnLoadUrl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Завантажити з мережі"
            android:layout_marginTop="8dp"
            app:layout_constraintTop_toBottomOf="@id/etNetworkUrl"
            app:layout_constraintStart_toStartOf="parent" />

        <TextView
            android:id="@+id/tvLocal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Локальні файли:"
            android:textStyle="bold"
            android:textSize="18sp"
            android:layout_marginTop="24dp"
            app:layout_constraintTop_toBottomOf="@id/btnLoadUrl"
            app:layout_constraintStart_toStartOf="parent" />

        <Button
            android:id="@+id/btnSelectAudio"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Обрати Аудіо"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="8dp"
            app:layout_constraintTop_toBottomOf="@id/tvLocal"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/btnSelectVideo" />

        <Button
            android:id="@+id/btnSelectVideo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Обрати Відео"
            android:layout_marginTop="12dp"
            android:layout_marginStart="8dp"
            app:layout_constraintTop_toBottomOf="@id/tvLocal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/btnSelectAudio" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>